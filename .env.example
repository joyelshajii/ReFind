# ==============================================================
# ReFind Environment Configuration
# Team: BitByBit
# ==============================================================

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
# For PostgreSQL with pgvector (recommended for production/docker):
# DATABASE_URL=postgresql://refind_user:refind_password@localhost:5432/refind_db
# If empty or PostgreSQL is not reachable, ReFind automatically uses the zero-config local SQLite + vector fallback:
DATABASE_URL=

# Available options: gemini, local, openai, jina
EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=gemini

# API Keys and Models
GEMINI_API_KEY=
JINA_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_REASONING_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual

# File Storage
UPLOAD_DIR=./storage/uploads
DEMO_DATA_DIR=./demo_data

